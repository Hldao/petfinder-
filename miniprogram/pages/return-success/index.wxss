.page {
  min-height: 100vh; background: var(--bg);
  display: flex; flex-direction: column;
}

.success-scroll {
  flex: 1; overflow-y: auto;
  padding: 60rpx 40rpx 200rpx;
}

/* Hero · 对齐原型：弹入 + 脉冲外环 + 文字上浮三段动画 */
.success-hero {
  text-align: center;
  padding: 64rpx 40rpx 32rpx;
}
@keyframes successCirclePop {
  0%   { opacity: 0; transform: scale(0.5); }
  60%  { opacity: 1; transform: scale(1.08); }
  100% { opacity: 1; transform: scale(1); }
}
@keyframes successRingPulse {
  0%, 100% { opacity: 0.25; transform: scale(1); }
  50%      { opacity: 0.45; transform: scale(1.05); }
}
@keyframes successTextRise {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.success-circle {
  width: 208rpx; height: 208rpx;
  margin: 0 auto 40rpx;
  background: linear-gradient(135deg, var(--mint), var(--mint-deep));
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 24rpx 64rpx rgba(91,184,159,0.4), inset 0 -8rpx 24rpx rgba(0,0,0,0.08);
  position: relative;
  animation: successCirclePop 0.5s cubic-bezier(0.2, 0.7, 0.3, 1.3) both;
}
.success-circle::before {
  content: ''; position: absolute; left: -20rpx; right: -20rpx; top: -20rpx; bottom: -20rpx;
  border-radius: 50%; border: 4rpx dashed var(--mint); opacity: 0.3;
  animation: successRingPulse 2.4s ease-in-out infinite;
}
.success-check {
  width: 96rpx; height: 96rpx; background: #fff; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: var(--mint); font-size: 48rpx; font-weight: 600;
}
.success-title {
  font-size: 44rpx; font-weight: 700; color: var(--ink-1);
  letter-spacing: -0.005em;
  margin-bottom: 16rpx;
  animation: successTextRise 0.5s cubic-bezier(0.2, 0.7, 0.3, 1) 0.25s both;
}
.success-sub {
  font-size: 26rpx; color: var(--ink-3); line-height: 1.7;
  animation: successTextRise 0.5s cubic-bezier(0.2, 0.7, 0.3, 1) 0.4s both;
}

/* 接力人数 · 暖橙主调（唯一真实数据展示）*/
.reunion-helpers {
  display: flex; align-items: center; justify-content: center; gap: 20rpx;
  background: var(--apricot-soft);
  border-radius: var(--radius-md);
  padding: 32rpx 36rpx;
  margin: 36rpx 0 28rpx;
}
.rh-emoji { font-size: 44rpx; }
.rh-text { font-size: 26rpx; color: var(--apricot-deep); font-weight: 600; }
.rh-text .b { font-weight: 700; color: var(--apricot-deep); font-size: 32rpx; margin: 0 4rpx; }

/* 致谢卡 · 克制纯白 */
.reunion-thank-card {
  display: flex; align-items: center; gap: 24rpx;
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  transition: transform 0.15s;
}
.card-hover { transform: scale(0.99); }
.rtc-icon {
  width: 80rpx; height: 80rpx;
  border-radius: var(--radius-md); background: var(--apricot-soft);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; color: var(--apricot-deep);
  flex-shrink: 0;
}
.rtc-body { flex: 1; min-width: 0; }
.rtc-title { font-size: 28rpx; font-weight: 700; color: var(--ink-1); }
.rtc-sub { font-size: 23rpx; color: var(--ink-3); margin-top: 6rpx; line-height: 1.5; }
.rtc-arrow { color: var(--ink-4); font-size: 32rpx; font-weight: 300; }

/* 分享卡 · 暖橙居中 */
.reunion-share-card {
  background: var(--apricot-soft);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  text-align: center;
  transition: transform 0.15s;
}
.rsc-title {
  font-size: 28rpx; font-weight: 700; color: var(--apricot-deep);
  margin-bottom: 8rpx;
}
.rsc-sub { font-size: 24rpx; color: #A05020; }

/* 冷却 */
.cooldown-tip {
  text-align: center;
  font-size: 22rpx; color: var(--mint-deep);
  background: var(--mint-soft);
  padding: 14rpx 28rpx;
  border-radius: var(--radius-pill);
  margin: 0 60rpx 24rpx;
}

/* 撤回 */
.undo-link {
  text-align: center;
  font-size: 22rpx; color: var(--ink-4);
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

/* Action bar */
.action-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: var(--surface);
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(31,31,31,0.06);
}
.btn-primary {
  height: 92rpx; border-radius: var(--radius-pill);
  background: linear-gradient(135deg, #FFA378 0%, var(--apricot) 100%);
  color: #fff; font-size: 30rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(255,133,82,0.35);
}
