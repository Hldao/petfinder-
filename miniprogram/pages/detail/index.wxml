<view wx:if="{{notFound}}" class="empty">没找到这条信息</view>

<view wx:elif="{{post}}" class="page">
  <view class="scroll-area">
    <!-- Hero -->
    <view class="hero {{statusCls}}">
      <swiper wx:if="{{post.photos && post.photos.length}}" class="hero-swiper"
              indicator-dots="{{post.photos.length > 1}}" indicator-active-color="#fff"
              circular="{{post.photos.length > 1}}">
        <swiper-item wx:for="{{post.photos}}" wx:key="*this">
          <image class="hero-img" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewPhoto"></image>
        </swiper-item>
      </swiper>
      <text wx:else class="hero-emoji">{{post.emoji}}</text>
      <view class="hero-status {{statusCls}}">{{post.statusLabel}}</view>
      <view class="hero-time">{{post.time}}</view>
    </view>

    <view class="detail-body">
      <view class="detail-name">{{post.name}}</view>
      <view class="detail-subtitle">{{post.breed}}{{post.sex ? ' · ' + post.sex : ''}}{{post.ageStage ? ' · ' + post.ageStageLabel : ''}}</view>

      <!-- 距离条 · 橙色渐变 pill · 点击唤起地图导航 -->
      <view class="detail-dist-bar" hover-class="dist-bar-hover" hover-stay-time="80" bindtap="onOpenMap">
        <view class="dist-bar-icon">📍</view>
        <view class="dist-bar-text">
          <view class="dist-bar-main">{{post.distanceKm ? '距你 ' + post.distanceKm + ' km' : post.loc}}</view>
          <view wx:if="{{post.distanceKm}}" class="dist-bar-sub">{{post.loc}}</view>
        </view>
        <view class="dist-bar-go">导航 ›</view>
      </view>

      <!-- 信息网格 2x2 -->
      <view class="info-grid">
        <view class="info-cell">
          <view class="label">{{locLabel}}</view>
          <view class="value">{{post.loc}}</view>
        </view>
        <view class="info-cell">
          <view class="label">{{timeLabel}}</view>
          <view class="value">{{post.time}}</view>
        </view>
      </view>

      <!-- 招领额外信息 -->
      <view wx:if="{{!isLost && (post.currentLocation || post.health)}}" class="info-extra">
        <view wx:if="{{post.currentLocation}}" class="info-extra-row">
          <view class="ie-icon">📍</view>
          <view class="ie-label">目前位置</view>
          <view class="ie-value">{{post.currentLocation}}</view>
        </view>
        <view wx:if="{{post.health}}" class="info-extra-row">
          <view class="ie-icon honey">💛</view>
          <view class="ie-label">健康</view>
          <view class="ie-value">{{post.health}}</view>
        </view>
      </view>

      <!-- 描述 -->
      <view class="section-label">{{isLost ? '特征描述' : '发现者描述'}}</view>
      <view class="desc-card">{{post.desc}}</view>

      <!-- 寻宠：线索区 -->
      <block wx:if="{{isLost}}">
        <view class="section-label">线索板块 <text class="count">{{post.clues.length || 0}}</text></view>
        <view wx:if="{{!post.clues.length}}" class="feature-card green">
          <text class="ic">🌿</text>
          <text>{{isOwner ? '还没有人留线索 · 有人看到 ta 会显示在这里' : '还没有线索 · 你的一条留言可能就是关键'}}</text>
        </view>
        <view wx:for="{{post.clues}}" wx:key="text" class="clue-card">
          <view class="clue-body">
            <view class="clue-avatar">{{item.name[0] || '陌'}}</view>
            <view class="clue-info">
              <view class="clue-top">
                <text class="clue-loc-time">{{item.loc ? item.loc + ' · ' : ''}}{{item.timeAgo}}</text>
                <text class="clue-badge">{{item.name}}</text>
              </view>
              <view class="clue-text">{{item.text}}</view>
            </view>
          </view>
        </view>

        <!-- 留一条公开线索（r17）· 仅非本人可留：「我看到了」是路人报目击，失主不目击自己的宠物 -->
        <view wx:if="{{!isOwner}}" class="clue-add-btn" bindtap="openClue">✏️ 我看到 ta 了 · 留条线索</view>
      </block>
    </view>
  </view>

  <!-- 底部 action bar · owner 视角 / 公开视角双形态 -->
  <view class="action-bar">
    <view class="btn-secondary" bindtap="onShare">⤴ 转发</view>
    <view wx:if="{{isOwner}}" class="btn-primary" bindtap="onManage">
      <text>📋</text>
      <text>管理我的帖子</text>
    </view>
    <view wx:else class="btn-primary" bindtap="onContact">
      <text>💬</text>
      <text>{{isLost ? '我看到 ta 了' : '私聊发现者'}}</text>
    </view>
  </view>

  <!-- 留线索弹窗 · bottom sheet（对齐原型 clue-modal）-->
  <view wx:if="{{showClue}}" class="clue-mask" bindtap="closeClue">
    <view class="clue-sheet" catchtap="noop">
      <view class="clue-head">
        <text class="clue-title">留下你看到的</text>
        <text class="clue-x" bindtap="closeClue">✕</text>
      </view>
      <text class="clue-sub">不用纠结格式 · 一句话也可以</text>
      <textarea class="clue-ta" placeholder="在哪儿？什么时候？看到什么？地点和时间会很有帮助。" value="{{clueText}}" bindinput="onClueInput" maxlength="200" auto-height="{{true}}" />
      <view class="clue-hint">ℹ️ 这条会公开展示给所有帮忙的人</view>
      <view class="clue-actions">
        <view class="clue-act cancel" bindtap="closeClue">取消</view>
        <view class="clue-act submit" bindtap="submitClue">发布线索</view>
      </view>
    </view>
  </view>
</view>
