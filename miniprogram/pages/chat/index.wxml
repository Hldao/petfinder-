<!-- 聊天 · 对齐 prototype v10 r129/r135/r138
 * 注：chat 是张润江模块
 * r129 短语文案 · r135 砍消息流末尾「举报/拉黑」常驻链接 · r138 ⋯ → 竖向 ⋮
 * 高级功能（cooldown-bar / meet-hint / chat-menu）留给张润江补 -->
<view class="page">

  <!-- chat-pet 卡片 · 顶部宠物信息条 -->
  <view wx:if="{{petName}}" class="chat-pet">
    <view class="chat-pet-thumb">{{emoji}}</view>
    <view class="chat-pet-body">
      <view class="chat-pet-name">关于 {{petName}}</view>
      <view class="chat-pet-meta">{{peerName}}</view>
    </view>
    <!-- r138 竖向 ⋮ · 与微信原生横向 ⋯ 视觉区分 -->
    <view class="sub-icon-chip" catchtap="onMore">⋮</view>
  </view>

  <!-- 消息流 -->
  <scroll-view scroll-y class="chat-msgs" scroll-into-view="{{scrollId}}" scroll-with-animation>
    <!-- 审核提示条 · 移入流顶 -->
    <view class="chat-audit-bar">🛡 消息经审核后送达 · 含微信号 / 电话 / 二维码将被过滤</view>

    <view wx:for="{{messages}}" wx:key="index" id="msg-{{index}}" class="chat-msg {{item.mine ? 'me' : 'them'}}">
      <view class="chat-avatar">{{item.mine ? '😊' : emoji}}</view>
      <!-- 图片消息 -->
      <image wx:if="{{item.type === 'image'}}" class="chat-bubble-img" src="{{item.content}}" mode="widthFix" data-src="{{item.content}}" bindtap="previewImg"></image>
      <!-- 定位消息 -->
      <view wx:elif="{{item.type === 'location'}}" class="chat-bubble chat-bubble-loc" data-lat="{{item.lat}}" data-lng="{{item.lng}}" data-name="{{item.content}}" bindtap="openMsgLoc">
        <view class="loc-row">📍 {{item.content}}</view>
        <view class="loc-hint">[位置] 点击查看地图</view>
      </view>
      <!-- 文字消息 -->
      <view wx:else class="chat-bubble">{{item.content}}</view>
    </view>

    <view wx:if="{{messages.length === 0}}" class="empty-hint">开始和 {{peerName}} 聊聊吧</view>
    <view class="stream-pad"></view>
  </scroll-view>

  <!-- 见面安全提示 · 防冒领靠见面反应（哲学第2条）· 可关闭 -->
  <view wx:if="{{meetHintShow}}" class="meet-hint">
    <view class="meet-hint-text">聊到要见面了？大理有安全见面建议，帮你避免冒领</view>
    <view class="meet-hint-btn" catchtap="onMeetGuide">查看建议</view>
    <view class="meet-hint-close" catchtap="closeMeetHint">✕</view>
  </view>

  <!-- Quick Reply · r129 文案 + 展开/收起 -->
  <view wx:if="{{quick.length}}" class="quick-replies {{quickExpanded?'expanded':''}}">
    <view wx:if="{{quickExpanded}}" class="quick-list">
      <view wx:for="{{quick}}" wx:key="label" class="qr-chip {{item.cls}}" data-text="{{item.text}}" bindtap="pickQuick">{{item.label}}</view>
    </view>
  </view>

  <!-- 输入栏 · 含 ⚡ 快捷触发 + 附件 + 发送 -->
  <view class="chat-input-bar">
    <view class="chat-attach qr-toggle {{quickExpanded?'active':''}}" bindtap="toggleQuick">⚡</view>
    <view class="chat-attach" bindtap="chooseImg">📷</view>
    <view class="chat-attach" bindtap="sendLoc">📍</view>
    <input class="chat-input" placeholder="输入消息…" value="{{input}}" bindinput="onInput" confirm-type="send" bindconfirm="send" />
    <view class="chat-attach chat-send" bindtap="send">↑</view>
  </view>
</view>
