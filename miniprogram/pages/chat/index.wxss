/* 聊天 · 对齐 prototype v10 r129/r135/r138
 * 注：chat 是张润江模块 · 本次只做视觉对齐 · js 业务流不动 */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* ============== chat-pet · 顶部宠物条 ============== */
.chat-pet {
  background: var(--surface);
  border-radius: var(--radius-md);
  margin: 20rpx 32rpx;
  padding: 20rpx 24rpx;
  display: flex; gap: 20rpx;
  align-items: center;
  box-shadow: var(--shadow-card);
}
.chat-pet-thumb {
  width: 76rpx; height: 76rpx;
  border-radius: 20rpx;
  background: var(--apricot-soft);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.chat-pet-body { flex: 1; min-width: 0; }
.chat-pet-name {
  font-size: 26rpx; font-weight: 700;
  color: var(--ink-1);
}
.chat-pet-meta {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 2rpx;
}

/* r137 sub-icon-chip · 让 ⋮ 操作按钮独立成"按钮" + r138 竖向 */
.sub-icon-chip {
  width: 64rpx; height: 64rpx;
  background: var(--bg);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
  color: var(--ink-2);
  flex-shrink: 0;
  font-weight: 700;
  letter-spacing: -2rpx;
}
.sub-icon-chip:active {
  background: var(--bg-deeper);
  transform: scale(0.96);
}

/* ============== 消息流 ============== */
.chat-msgs {
  flex: 1;
  padding: 16rpx 32rpx 0;
}

/* 审核提示条 · honey 暖色 */
.chat-audit-bar {
  padding: 12rpx 32rpx;
  background: var(--honey-soft);
  border-radius: var(--radius-md);
  font-size: 21rpx;
  color: var(--honey-deep);
  text-align: center;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.chat-msg {
  margin-bottom: 24rpx;
  display: flex;
  gap: 16rpx;
}
.chat-msg.me {
  flex-direction: row-reverse;
}
.chat-avatar {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx;
  background: var(--apricot-soft);
}
.chat-bubble {
  max-width: 70%;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.chat-msg.me .chat-bubble {
  background: var(--apricot);
  color: #fff;
  border-radius: 32rpx 32rpx 8rpx 32rpx;
}
.chat-msg.them .chat-bubble {
  background: var(--surface);
  color: var(--ink-1);
  border-radius: 32rpx 32rpx 32rpx 8rpx;
  box-shadow: var(--shadow-card);
}

/* 图片消息气泡 · 宽度自适应高度，点击全屏预览 */
.chat-bubble-img {
  max-width: 56%;
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
}
/* 定位消息气泡 · 复用 .chat-bubble 的 me/them 配色 */
.chat-bubble-loc { display: block; }
.loc-row { font-weight: 600; }
.loc-hint { font-size: 20rpx; opacity: 0.7; margin-top: 4rpx; }

.empty-hint {
  text-align: center;
  color: var(--ink-4);
  font-size: 24rpx;
  padding: 80rpx 0;
}
.stream-pad { height: 24rpx; }

/* ============== Quick Reply · r129 文案 + 展开收起 ============== */
.quick-replies {
  background: var(--surface);
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
  overflow: hidden;
  max-height: 0;
  padding: 0 28rpx;
  border-top: 0 solid var(--divider-soft);
  transition: max-height 0.25s ease, padding 0.25s ease, border-top-width 0.25s ease;
}
.quick-replies.expanded {
  max-height: 280rpx;
  padding: 20rpx 28rpx;
  border-top-width: 2rpx;
}
.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.qr-chip {
  padding: 14rpx 28rpx;
  background: var(--bg);
  border: 2rpx solid var(--divider);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-2);
  white-space: nowrap;
}
.qr-chip.primary {
  background: var(--apricot-soft);
  color: var(--apricot-deep);
  border-color: var(--apricot);
}
.qr-chip.action {
  background: var(--mint-soft);
  color: var(--mint-deep);
  border-color: var(--mint);
}

/* 见面安全提示条 · 对齐原型 meet-hint */
.meet-hint {
  margin: 0 32rpx 12rpx; padding: 20rpx 26rpx;
  background: linear-gradient(135deg, var(--apricot-soft), var(--honey-soft));
  border-radius: var(--radius-md); border: 3rpx solid var(--apricot);
  display: flex; align-items: center; gap: 20rpx;
}
.meet-hint-text { flex: 1; font-size: 24rpx; color: var(--apricot-deep); font-weight: 600; line-height: 1.4; }
.meet-hint-btn { font-size: 23rpx; font-weight: 700; color: #fff; background: var(--apricot); padding: 10rpx 24rpx; border-radius: var(--radius-pill); white-space: nowrap; flex-shrink: 0; }
.meet-hint-close { font-size: 28rpx; color: var(--apricot-deep); opacity: 0.5; flex-shrink: 0; line-height: 1; padding: 4rpx; }

/* ============== 输入栏 ============== */
.chat-input-bar {
  background: var(--surface);
  border-top: 2rpx solid var(--divider);
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex; gap: 16rpx;
  align-items: center;
}
.chat-attach {
  width: 72rpx; height: 72rpx;
  background: var(--bg);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
  color: var(--ink-2);
  flex-shrink: 0;
}
.chat-attach.qr-toggle.active {
  color: var(--apricot-deep);
  background: var(--apricot-soft);
}
.chat-input {
  flex: 1;
  height: 72rpx;
  background: var(--bg);
  border-radius: var(--radius-pill);
  padding: 0 28rpx;
  font-size: 26rpx;
  color: var(--ink-1);
  min-width: 0;
}
.chat-send {
  background: var(--apricot);
  color: #fff;
  font-weight: 700;
}
