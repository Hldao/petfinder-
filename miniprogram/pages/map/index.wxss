/* 地图 · 对齐 prototype v10 r87/r90 */

.page {
  position: relative;
  width: 100%;
  height: 100vh;
}

.map {
  width: 100%;
  height: 100vh;
}

/* r90 precision-hint · 让位胶囊（top 50~82 / right 7~94）+ 5s 后猫猫可加 dismiss */
.map-precision-hint {
  position: fixed;
  left: 32rpx;
  right: 192rpx;
  top: 180rpx;
  background: rgba(255,255,255,0.92);
  border-radius: var(--radius-pill);
  padding: 14rpx 28rpx;
  display: flex; align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(31,31,31,0.08);
  font-size: 22rpx;
  color: var(--ink-2);
  z-index: 10;
}
.mph-icon {
  font-size: 26rpx;
  flex-shrink: 0;
}
.mph-text {
  font-size: 22rpx;
  color: var(--ink-2);
  font-weight: 600;
  flex: 1;
}

/* ============ 底部宠物面板 · 对齐原型 map-bottom-sheet ============ */
.map-sheet {
  position: fixed; left: 0; right: 0;
  bottom: calc(132rpx + env(safe-area-inset-bottom));   /* 让位底部 tabBar */
  background: var(--surface);
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -16rpx 48rpx rgba(0,0,0,0.1);
  z-index: 10;
}
.sheet-drag { padding: 4rpx 0 0; }
.sheet-handle {
  width: 72rpx; height: 8rpx;
  background: var(--ink-4); opacity: 0.5;
  border-radius: 4rpx; margin: 12rpx auto;
}
.sheet-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 4rpx 36rpx 12rpx;
}
.sheet-title { font-size: 28rpx; font-weight: 700; color: var(--ink-1); }
.sheet-toggle { font-size: 22rpx; color: var(--apricot-deep); font-weight: 600; }
.sheet-filter-row { display: flex; gap: 16rpx; padding: 0 36rpx 16rpx; }
.sfc {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 8rpx 24rpx;
  background: var(--bg);
  border-radius: var(--radius-pill);
  font-size: 24rpx; color: var(--ink-3); font-weight: 600;
}
.sfc.active { background: var(--apricot-deep); color: #fff; }
.sfc-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.sfc-dot.lost { background: var(--apricot); }
.sfc-dot.found { background: var(--mint); }

.sheet-scroll {
  max-height: 220rpx;
  padding: 0 24rpx 16rpx;
  transition: max-height 0.28s ease;
}
.map-sheet.expanded .sheet-scroll { max-height: 52vh; }
.sheet-empty { text-align: center; color: var(--ink-4); font-size: 24rpx; padding: 60rpx 0; }

.sheet-card {
  display: flex; align-items: center; gap: 20rpx;
  padding: 16rpx; margin-bottom: 8rpx;
  border-radius: var(--radius-sm);
}
.sheet-card:active { background: var(--bg); }
.sheet-thumb {
  width: 88rpx; height: 88rpx; flex-shrink: 0;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,0.05), inset 0 0 0 2rpx rgba(255,255,255,0.4);
}
.sheet-thumb.lost  { background: linear-gradient(135deg, var(--apricot-soft) 0%, #FFCDA8 100%); }
.sheet-thumb.found { background: linear-gradient(135deg, var(--mint-soft) 0%, #ABDDCB 100%); }
.sheet-info { flex: 1; min-width: 0; }
.sheet-pet-name { font-size: 28rpx; font-weight: 700; color: var(--ink-1); letter-spacing: -0.005em; }
.sheet-tag {
  font-size: 20rpx; padding: 2rpx 12rpx; border-radius: var(--radius-pill);
  font-weight: 700; margin-left: 4rpx;
}
.sheet-tag.lost  { background: var(--apricot-soft); color: var(--apricot-deep); }
.sheet-tag.found { background: var(--mint-soft); color: var(--mint-deep); }
.sheet-pet-meta { font-size: 22rpx; color: var(--ink-3); margin-top: 4rpx; }

/* 离屏绘制用 canvas · 移出可视区（不可用 display:none，否则取不到 node 尺寸）*/
.pin-canvas {
  position: fixed;
  left: -9999rpx; top: -9999rpx;
  width: 40px; height: 52px;
}
