<!-- 地图 · 对齐 prototype v10 全套（marker 水滴针 / 底部面板 / 迷你详情卡 / map-fab / 搜索 / 精度提示）-->
<view class="page">
  <map
    class="map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    bindmarkertap="onMarkerTap"
    bindcallouttap="onCalloutTap"
    bindtap="onMapTap"
    show-location="{{showLoc}}"
  >
    <!-- 点针弹出的自定义气泡（跟随针 · 对齐原型 pin-popup）-->
    <cover-view slot="callout">
      <cover-view wx:for="{{markers}}" wx:key="id" marker-id="{{item.id}}" class="mc {{item.statusCls}}">
        <cover-view class="mc-top">
          <cover-view class="mc-name">{{item.calloutName}}</cover-view>
          <cover-view class="mc-tag">{{item.calloutTag}}</cover-view>
        </cover-view>
        <cover-view class="mc-dist">{{item.calloutDist}}</cover-view>
        <cover-view class="mc-go">查看详情 ›</cover-view>
      </cover-view>
    </cover-view>
  </map>

  <!-- r90 precision-hint · 隐私精度提示（可✕关闭）-->
  <view wx:if="{{showHint}}" class="map-precision-hint">
    <text class="mph-icon">🛡</text>
    <text class="mph-text">位置精度模糊处理至 500m 以保护隐私</text>
    <view class="mph-close" catchtap="dismissHint">✕</view>
  </view>

  <!-- 地图工具按钮 map-fab：定位 / 查找 / 筛选 -->
  <view class="map-fab">
    <view class="mf-btn mf-locate" catchtap="locateMe"></view>
    <view class="mf-btn mf-search {{searchOpen ? 'on' : ''}}" catchtap="toggleSearch"></view>
    <view class="mf-btn mf-filter" catchtap="toggleFilter"></view>
  </view>

  <!-- 地图内搜索面板 -->
  <view wx:if="{{searchOpen}}" class="map-search-panel">
    <input class="map-search-input" placeholder="输入宠物名称或特征…" value="{{searchKw}}" bindinput="onSearchInput" confirm-type="search"/>
    <scroll-view wx:if="{{searchKw}}" scroll-y class="map-search-results">
      <view wx:if="{{!searchResults.length}}" class="msr-empty">没有匹配的宠物</view>
      <view wx:for="{{searchResults}}" wx:key="id" class="msr-row" data-id="{{item.id}}" catchtap="onResultTap">
        <view class="msr-thumb {{item.statusCls}}"><image wx:if="{{item.photo}}" class="thumb-img" src="{{item.photo}}" mode="aspectFill"></image><text wx:else>{{item.emoji}}</text></view>
        <view class="msr-info">
          <view class="msr-name">{{item.name}}</view>
          <view class="msr-meta">{{item.loc}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部单一抽屉（苹果地图式）：点针→此面板升起展示该宠物详情；否则→附近列表 -->
  <view class="map-sheet {{dragging ? 'dragging' : ''}}" style="height:{{sheetH}}px">
    <view class="sheet-drag"
          catchtouchstart="onDragStart" catchtouchmove="onDragMove" catchtouchend="onDragEnd">
      <view class="sheet-handle"></view>
      <view class="sheet-drag-hint">{{selected ? '下拉返回列表' : (sheetExpanded ? '下拉收起' : '上滑查看更多 ↑')}}</view>
    </view>

    <!-- 选中某宠物 → 详情视图（并入面板内）-->
    <view wx:if="{{selected}}" class="sheet-detail-inner">
      <view class="sdc-back" catchtap="closeSelected">‹ 返回列表</view>
      <view class="sdc-hero">
        <view class="sdc-emoji {{selected.statusCls}}"><image wx:if="{{selected.photo}}" class="thumb-img" src="{{selected.photo}}" mode="aspectFill"></image><text wx:else>{{selected.emoji}}</text></view>
        <view class="sdc-meta">
          <view class="sdc-name">{{selected.name}}</view>
          <view class="sdc-breed">{{selected.breed}}</view>
        </view>
        <view class="sdc-status {{selected.statusCls}}">{{selected.statusLabel}}</view>
      </view>
      <view class="sdc-loc">📍 <text class="hl">{{selected.loc}}</text>{{selected.distText}}</view>
      <view wx:if="{{selected.desc}}" class="sdc-desc">{{selected.desc}}</view>
      <view class="sdc-actions">
        <view class="sdc-btn-primary {{selected.statusCls}}" catchtap="onSelectedContact">💬 {{selected.statusCls === 'lost' ? '我看到 ta 了' : '私聊发现者'}}</view>
        <view class="sdc-btn-detail" data-id="{{selected.id}}" catchtap="onSelectedDetail">查看详情</view>
      </view>
    </view>

    <!-- 否则 → 附近列表 -->
    <block wx:else>
      <view class="sheet-header">
        <view class="sheet-title">附近 · {{sheetCount}} 条信息</view>
        <view class="sheet-toggle" bindtap="toggleSheet">{{sheetExpanded ? '收起' : '展开'}}</view>
      </view>
      <view class="sheet-filter-row">
        <view class="sfc {{sheetFilter === '' ? 'active' : ''}}" data-sf="" bindtap="applySheetFilter">全部</view>
        <view class="sfc {{sheetFilter === 'lost' ? 'active' : ''}}" data-sf="lost" bindtap="applySheetFilter"><view class="sfc-dot lost"></view>丢失</view>
        <view class="sfc {{sheetFilter === 'found' ? 'active' : ''}}" data-sf="found" bindtap="applySheetFilter"><view class="sfc-dot found"></view>招领</view>
      </view>
      <scroll-view scroll-y class="sheet-scroll" enable-flex>
        <view wx:if="{{!sheetCards.length}}" class="sheet-empty">这一带暂时还没有信息</view>
        <view wx:for="{{sheetCards}}" wx:key="id" class="sheet-card" data-id="{{item.id}}" bindtap="onSheetCardTap">
          <view class="sheet-thumb {{item.statusCls}}"><image wx:if="{{item.photo}}" class="thumb-img" src="{{item.photo}}" mode="aspectFill"></image><text wx:else>{{item.emoji}}</text></view>
          <view class="sheet-info">
            <view class="sheet-pet-name">{{item.name}} <text class="sheet-tag {{item.statusCls}}">{{item.statusLabel}}</text></view>
            <view class="sheet-pet-meta">{{item.loc}}{{item.distText}}</view>
          </view>
        </view>
      </scroll-view>
    </block>
  </view>

  <!-- 离屏 canvas · 运行时绘制 橙/绿水滴+emoji 的 marker 图标 -->
  <canvas type="2d" id="pinCanvas" class="pin-canvas"></canvas>
</view>
