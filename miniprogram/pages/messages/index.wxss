/* 消息列表 · 对齐 prototype v10 r108/r109/r139 */

.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.title-bar {
  font-size: 36rpx; font-weight: 800;
  color: var(--ink-1);
  padding: 36rpx 32rpx 16rpx;
}

/* ============== mp-tabs · r139 上下 padding 对称（12/16/12） ============== */
.mp-tabs {
  display: flex;
  padding: 24rpx 32rpx;
  gap: 12rpx;
}
.mp-tab {
  padding: 12rpx 28rpx;
  font-size: 25rpx;
  color: var(--ink-3);
  font-weight: 600;
  border-radius: var(--radius-pill);
  background: var(--surface);
  box-shadow: var(--shadow-pill);
}
.mp-tab.active {
  background: var(--apricot-deep);
  color: #fff;
  font-weight: 700;
  box-shadow: none;
}

/* ============== 消息列表 · r139 padding-top 0 与 mp-tabs 下间距 12 对称 ============== */
.msg-list {
  flex: 1;
  padding: 0 32rpx 200rpx;
  display: flex; flex-direction: column;
  gap: 12rpx;
}

.msg-row {
  display: flex; gap: 24rpx;
  align-items: center;
  background: var(--surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 20rpx 28rpx;
  position: relative;
}

/* r108 圆形 / r109 84rpx 紧凑 */
.msg-avatar {
  width: 84rpx; height: 84rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--apricot-soft);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
}
.msg-avatar.orange { background: #FFE8D6; }
.msg-avatar.blue { background: #D6E8FF; }
.msg-avatar.mint { background: var(--mint-soft); }
.msg-avatar.cream { background: #FFF3DC; }
.msg-avatar.mp {
  background: linear-gradient(135deg, var(--mint), var(--mint-deep));
  color: #fff;
  font-size: 40rpx;
}

.msg-body { flex: 1; min-width: 0; }

.msg-row-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 4rpx;
}
.msg-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-1);
  letter-spacing: -0.005em;
}
.msg-mp-tag {
  font-size: 20rpx;
  color: var(--mint-deep);
  background: var(--mint-soft);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
  margin-left: 8rpx;
}
.msg-time {
  font-size: 21rpx;
  color: var(--ink-4);
  font-weight: 600;
  flex-shrink: 0;
}

/* r109 unread 右侧居中 · 给 preview/context 留 56rpx */
.msg-preview {
  font-size: 24rpx;
  color: var(--ink-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.5;
  padding-right: 56rpx;
}
.msg-prefix {
  font-size: 24rpx;
  color: var(--ink-4);
  font-weight: 500;
  margin-right: 2rpx;
}

/* r108 视觉降级 · 去 chip 背景 · 仅留颜色提示 */
.msg-context {
  font-size: 21rpx;
  color: var(--apricot-deep);
  margin-top: 6rpx;
  font-weight: 500;
}
.msg-context.reply { color: var(--mint-deep); }

/* r109 unread 右侧垂直居中 (QQ/小红书标准) */
.msg-unread {
  position: absolute;
  top: 50%; right: 28rpx;
  transform: translateY(-50%);
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  background: var(--apricot);
  color: #fff;
  font-size: 21rpx;
  font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(255,133,82,0.4);
}

.empty {
  text-align: center;
  color: var(--ink-4);
  font-size: 26rpx;
  padding: 80rpx 0;
}
