/* 首页 Feed · 对齐 prototype v10（navbar/search/chip/stat-bar/section/empty）
 * 数值 = 原型 px × 2 → rpx · token 引用 app.wxss
 * 注：sort-sheet / archive-section 完整交互留给猫猫补；modal 为小程序专属（隐私/启动）*/

.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ============== nav-region · 吸顶 · 原型 r71/r110：白底 + 底线 ============== */
.nav-region {
  position: sticky; top: 0;
  z-index: 10;
  background: var(--surface);
  padding: 8rpx 36rpx 24rpx;
  padding-right: 192rpx;          /* 让位右上角胶囊 */
  border-bottom: 2rpx solid var(--divider);
}
.nav-row { display: flex; align-items: center; gap: 20rpx; }

/* r71 city-tag 视觉降级 · 透明底黑字 · 搜索栏才是主角 · pin 保留杏橘锚 */
.city-tag {
  display: flex; align-items: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 20rpx 0 8rpx;
  background: transparent;
  border-radius: var(--radius-pill);
  font-size: var(--text-base); font-weight: 700;
  color: var(--ink-1);
  flex-shrink: 0;
}
.city-tag:active { background: var(--bg); transform: scale(0.97); }
.city-tag .pin {
  width: 40rpx; height: 40rpx;
  background: var(--apricot);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
}
.city-name {
  max-width: 96rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* r110 · search-pill 米色 + inset hairline · 凹陷输入区观感 */
.search-pill {
  flex: 1; min-width: 0;
  height: 72rpx;
  display: flex; align-items: center;
  gap: 14rpx;
  background: var(--bg);
  border-radius: var(--radius-pill);
  padding: 0 28rpx;
  font-size: 25rpx;
  color: var(--ink-4);
  overflow: hidden;
  box-shadow: inset 0 0 0 2rpx rgba(0,0,0,0.05);
}
.sp-icon { flex-shrink: 0; }
.sp-placeholder {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ============== Scroll area ============== */
.scroll-area {
  padding: 0;
}

/* ============== filter-region · r85 跟内容滚 ============== */
.filter-region {
  background: var(--bg);
  padding: 28rpx 36rpx 8rpx;
}
.filter-row {
  display: flex; align-items: center;
  gap: 16rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 8rpx;
}
.filter-row::-webkit-scrollbar { display: none; }

.chip {
  display: inline-flex; align-items: center;
  gap: 12rpx;
  padding: 14rpx 28rpx;
  background: var(--surface);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  color: var(--ink-2);
  font-weight: 500;
  box-shadow: var(--shadow-pill);
  flex-shrink: 0;
}
/* r98 chip.active 跟杏橘品牌主色 */
.chip.active {
  background: var(--apricot-deep);
  color: #fff;
  font-weight: 700;
  box-shadow: none;
}
.chip-dot {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* r124 chip-sort · 与普通 chip 同款（surface + shadow-pill）+ chevron 提示 */
.chip.chip-sort {
  background: var(--surface);
  color: var(--ink-2);
  font-weight: 600;
  box-shadow: var(--shadow-pill);
  margin-left: auto;
}
.cs-ic { font-size: 22rpx; }
.chevron-down {
  font-size: 20rpx;
  opacity: 0.55;
  margin-left: -2rpx;
}

/* ============== r45 feed-stat-bar · 希望叙事条 ============== */
.feed-stat-bar {
  margin: 12rpx 32rpx 28rpx;
  padding: 22rpx 28rpx 24rpx;
  background: linear-gradient(135deg, #FFF4EB 0%, #FFFAF3 100%);
  border-radius: 24rpx;
  border: 2rpx solid rgba(255,133,82,0.16);
  display: flex; align-items: center;
  gap: 22rpx;
}
.fsb-ic {
  width: 56rpx; height: 56rpx;
  background: #fff;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(255,133,82,0.15);
  flex-shrink: 0;
}
.fsb-body { flex: 1; min-width: 0; line-height: 1.5; }
.fsb-line {
  font-size: 24rpx;
  color: var(--ink-2);
  font-weight: 600;
  line-height: 1.5;
}
.fsb-soft { color: var(--ink-3); }
.fsb-tagline {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--apricot-deep);
  font-weight: 700;
  letter-spacing: 0.02em;
}

/* ============== Section header ============== */
.section-header {
  display: flex; align-items: baseline; gap: 20rpx;
  padding: 28rpx 32rpx 20rpx;
}
.section-header .title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: -0.005em;
  color: var(--ink-1);
}
.section-header .count {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--ink-3);
  letter-spacing: 0.04em;
}

/* ============== List ============== */
.feed-list {
  display: flex; flex-direction: column;
  gap: 24rpx;
  padding: 16rpx 32rpx;
}

.hint {
  text-align: center;
  color: var(--ink-4);
  padding: 60rpx 0;
  font-size: 26rpx;
}

/* r68 空状态对齐统一系统 */
.feed-empty-state {
  text-align: center;
  padding: 80rpx 48rpx 48rpx;
}
.fe-icon {
  font-size: 112rpx;
  opacity: 0.35;
  line-height: 1;
}
.fe-title {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--ink-1);
  font-weight: 700;
}

.seed-note {
  text-align: center;
  color: var(--ink-4);
  font-size: 21rpx;
  padding: 24rpx 0;
}

/* ============== Modal 启动遮罩（小程序专属：隐私/启动协议）============== */
.mask {
  position: fixed; inset: 0; z-index: 200;
  background: rgba(31,31,31,0.5);
  display: flex; align-items: center; justify-content: center;
  padding: 0 56rpx;
}
.modal {
  width: 100%;
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 44rpx 40rpx 32rpx;
}
.m-title {
  font-size: 32rpx; font-weight: 800;
  color: var(--ink-1);
  text-align: center;
}
.m-body {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.7;
  margin: 28rpx 0;
}
.m-btn {
  height: 84rpx;
  border-radius: var(--radius-pill);
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700;
  margin-top: 16rpx;
}
.m-btn.primary { background: var(--apricot); color: #fff; }
.m-btn.primary.disabled { opacity: 0.4; }
.m-btn.ghost { background: var(--bg); color: var(--ink-3); }
.m-btn.secondary { background: var(--bg); color: var(--ink-2); }

/* 隐私 modal · r127/r128 */
.privacy-modal { padding: 40rpx 36rpx 28rpx; }
.m-icon {
  font-size: 56rpx;
  text-align: center;
  margin-bottom: 8rpx;
}
.m-sub {
  font-size: 22rpx;
  color: var(--ink-3);
  text-align: center;
  margin-top: 8rpx;
}
.m-section-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-1);
  margin-bottom: 12rpx;
}
.m-item {
  display: flex; gap: 14rpx;
  align-items: flex-start;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.6;
  margin-bottom: 10rpx;
}
.m-item-num {
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  background: var(--apricot-soft);
  color: var(--apricot-deep);
  font-size: 20rpx;
  font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.b { font-weight: 700; }
.m-list-footer {
  font-size: 21rpx;
  color: var(--ink-4);
  margin-top: 14rpx;
  line-height: 1.5;
}
.m-agree {
  display: flex; align-items: flex-start;
  gap: 14rpx;
  margin: 20rpx 0;
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.5;
}
.m-check {
  width: 32rpx; height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--ink-4);
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
  background: #fff;
}
.m-check.checked {
  background: var(--apricot);
  border-color: var(--apricot);
  color: #fff;
}
.m-link { color: var(--apricot-deep); font-weight: 600; }
.m-actions {
  display: flex; gap: 16rpx;
  margin-top: 16rpx;
}
.m-actions .m-btn { flex: 1; margin-top: 0; }
.m-actions .m-btn.primary { flex: 1.6; }
