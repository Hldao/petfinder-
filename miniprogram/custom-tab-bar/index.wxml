<view class="tab-bar">
  <block wx:for="{{list}}" wx:key="text">
    <view
      class="tab {{selected === index ? 'active' : ''}}"
      data-path="{{item.pagePath}}"
      bindtap="switchTab"
    >
      <view class="ti-icon {{item.iconCls}}">{{item.icon}}</view>
      <text class="ti-text">{{item.text}}</text>
    </view>

    <!-- 中央内嵌发布键 · 排在 地图(index 1) 之后 · 对齐原型 5 格布局 -->
    <view wx:if="{{index === 1}}" class="fab-tab" bindtap="onPublish">
      <view class="fab-bubble"><text class="fab-plus">＋</text></view>
    </view>
  </block>
</view>
