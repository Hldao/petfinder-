<view class="pet-card {{post.isMine ? 'my-card' : ''}} {{statusCls === 'found' ? 'found-card' : ''}}" bindtap="onTap">
  <!-- 真实目击横幅 · 仅有线索时显示（点击冒泡到卡片进详情）-->
  <view wx:if="{{hintText}}" class="card-hint-strip {{statusCls}}">
    <text class="hint-text">{{hintText}}</text>
    <text class="hint-arrow">›</text>
  </view>
  <view class="pc-body">
    <view class="pc-photo {{photoCls}}">
      <image wx:if="{{post.photos && post.photos.length && !imgError}}" class="pc-img" src="{{post.photos[0]}}" mode="aspectFill" lazy-load binderror="onImgError"></image>
      <text wx:else class="emoji">{{post.emoji}}</text>
      <view class="status-bubble {{statusCls}}">{{post.statusLabel}}</view>
    </view>
    <view class="pc-info">
      <view class="pc-name-row">
        <text class="pc-name">{{displayName}}</text>
        <text wx:if="{{metaText}}" class="breed">· {{metaText}}</text>
      </view>
      <view class="pc-meta">
        <text class="loc-link" catchtap="onLoc">{{locLine}}</text>
        <text class="time">{{post.time}}</text>
      </view>
      <view class="pc-desc">{{post.desc}}</view>
    </view>
  </view>
  <view class="pc-footer">
    <view wx:if="{{post.isMine}}" class="pc-mine">✏ 我发布的</view>
    <text class="pc-action">{{helpersText}}</text>
    <!-- 真转发：open-type=share 触发微信原生转发；catchtap 拦住不冒泡到卡片(进详情) -->
    <button class="pc-action share" open-type="share"
            data-id="{{post.id}}" data-name="{{displayName}}" data-loc="{{post.loc}}" data-status="{{post.statusLabel}}" data-img="{{post.photos[0]}}"
            catchtap="noop">⤴ 转发</button>
  </view>
</view>
