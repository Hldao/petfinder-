/* pet-card · 对齐原型 prototypes/app-prototype-v10.html .pet-card 全套
 * 数值 = 原型 px × 2 → rpx · token 引用 app.wxss */
.pet-card {
  position: relative;
  background: var(--surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: transform 0.18s, box-shadow 0.18s;
}
.pet-card:active { transform: scale(0.99); }

/* 真实目击横幅 · 对齐原型 .card-hint-strip（顶部一条，卡片 overflow:hidden 已裁圆角）*/
.card-hint-strip {
  display: flex; align-items: center; gap: 12rpx;
  padding: 16rpx 28rpx;
  font-size: 23rpx; font-weight: 600;
}
.card-hint-strip.lost  { background: var(--apricot-soft); color: var(--apricot-deep); border-bottom: 2rpx solid rgba(255,133,82,0.15); }
.card-hint-strip.found { background: var(--mint-soft);    color: var(--mint-deep);    border-bottom: 2rpx solid rgba(91,184,159,0.15); }
.card-hint-strip .hint-text { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.card-hint-strip .hint-arrow { flex-shrink: 0; font-size: 26rpx; opacity: 0.7; }

/* 自己发布的帖 · 浅杏橘渐变 + 专属阴影（原型 .my-card）*/
.pet-card.my-card {
  background: linear-gradient(135deg, #FFFAF4 0%, #FFFFFF 40%);
  box-shadow: 0 12rpx 36rpx rgba(255,133,82,0.12),
              0 0 0 2rpx rgba(255,133,82,0.10);
}
.pet-card.my-card .pc-photo {
  box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,0.05),
              inset 0 0 0 2rpx rgba(255,255,255,0.4),
              0 0 0 4rpx var(--surface);
}

.pc-body { display: flex; padding: var(--space-4); gap: var(--space-4); align-items: flex-start; }
.pc-photo {
  width: 148rpx; height: 148rpx; flex-shrink: 0; border-radius: 32rpx;
  display: flex; align-items: center; justify-content: center;
  position: relative;
  box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,0.05),
              inset 0 0 0 2rpx rgba(255,255,255,0.4);
}
.pc-photo.lost  { background: linear-gradient(135deg, var(--apricot-soft) 0%, #FFCDA8 100%); }
.pc-photo.found { background: linear-gradient(135deg, var(--mint-soft) 0%, #ABDDCB 100%); }
/* 6 色 photoClass · 对齐原型 .ph-*（无真实照片时让卡片底色多彩，不再寻宠/招领两色单调）*/
.pc-photo.ph-orange { background: linear-gradient(135deg, #FFE9DD 0%, #FFCDA8 100%); }
.pc-photo.ph-blue   { background: linear-gradient(135deg, #DDE7F4 0%, #B5C7E0 100%); }
.pc-photo.ph-cream  { background: linear-gradient(135deg, #FFF3D6 0%, #FFDD9C 100%); }
.pc-photo.ph-mint   { background: linear-gradient(135deg, #DDF1EA 0%, #ABDDCB 100%); }
.pc-photo.ph-pink   { background: linear-gradient(135deg, #FCE4E4 0%, #F5BFBF 100%); }
.pc-photo.ph-plum   { background: linear-gradient(135deg, #EDE2F8 0%, #CFB5E6 100%); }
.pc-photo .emoji { font-size: 72rpx; line-height: 1; display: block; }
/* 真实照片 · 填满方框（fileID 直接作 src，cloud.init 后小程序自动解析）*/
.pc-photo .pc-img { width: 100%; height: 100%; border-radius: 32rpx; display: block; }

.status-bubble {
  position: absolute; top: -6rpx; left: -6rpx;
  padding: 6rpx 18rpx; border-radius: var(--radius-pill);
  font-size: var(--text-xs); font-weight: 700; color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.12),
              0 0 0 4rpx rgba(255,255,255,0.95);
  z-index: 2; white-space: nowrap; letter-spacing: 0.02em;
}
.status-bubble.lost  { background: var(--apricot); }
.status-bubble.found { background: var(--mint); }

.pc-info { flex: 1; min-width: 0; padding-top: 4rpx; }
.pc-name-row { display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 8rpx; min-width: 0; overflow: hidden; }
.pc-name {
  font-size: 32rpx; font-weight: 700; letter-spacing: -0.005em;
  flex-shrink: 0; max-width: 70%;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.breed {
  font-size: 23rpx; color: var(--ink-3); font-weight: 500;
  flex: 0 1 auto; min-width: 0;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.pc-meta { font-size: 24rpx; color: var(--ink-3); margin-bottom: 12rpx; display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
/* 地点·距离 = 可点击导航链接 · 对齐原型 .loc-link 点状下划线 */
.pc-meta .loc-link { border-bottom: 1rpx dotted var(--ink-4); }
.pc-meta .time { color: var(--ink-3); font-weight: 600; font-feature-settings: 'tnum'; }
.pc-desc {
  font-size: 25rpx; color: var(--ink-2); line-height: 1.55;
  overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}

.pc-footer {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 28rpx 24rpx; border-top: 2rpx solid var(--divider-soft);
}
.pc-action { font-size: 23rpx; color: var(--ink-3); font-weight: 600; display: flex; align-items: center; gap: 6rpx; }
.pc-action.share {
  margin-left: auto; color: var(--apricot-deep);
  background: var(--apricot-soft); padding: 8rpx 20rpx; border-radius: var(--radius-pill); font-weight: 700;
}
/* found 卡转发按钮换薄荷色（原型 .found-card .pc-action.share）*/
.pet-card.found-card .pc-action.share { color: var(--mint-deep); background: var(--mint-soft); }
/* 转发是 <button open-type=share> · 重置 button 默认样式贴合原 pill */
button.pc-action.share {
  display: inline-flex; align-items: center; gap: 6rpx;
  min-height: 0; line-height: 1.2;
  margin: 0 0 0 auto; padding: 8rpx 20rpx;
  font-size: 23rpx; font-weight: 700;
  border: none;
}
button.pc-action.share::after { border: none; }

/* 「我发布的」小标识 · footer 左下角（原型 .pc-mine）*/
.pc-mine {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 6rpx 18rpx;
  background: var(--apricot-soft);
  color: var(--apricot-deep);
  border-radius: 999rpx;
  font-size: 21rpx; font-weight: 700;
  letter-spacing: 0.02em;
  flex-shrink: 0;
}
